{
  "name": "smash-clone",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "2D-Platform-Fighter in F# (Fable) auf HTML5 Canvas",
  "scripts": {
    "setup": "dotnet tool restore && dotnet restore",
